{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "promo-result.schema.json",
  "title": "PromoGenerationResult",
  "type": "object",
  "required": ["requestId", "basedOnProjectVersion", "status", "createdAt"],
  "properties": {
    "requestId": { "type": "string", "format": "uuid" },
    "basedOnProjectVersion": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["succeeded", "failed"] },
    "promoImage": {
      "type": "object",
      "properties": {
        "imagePath": { "type": "string" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "promoCopy": {
      "type": "object",
      "properties": {
        "promoTitle": { "type": "string" },
        "promoDescription": { "type": "string" },
        "promoHighlights": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
